# Require administrator privileges
$currentUser = [Security.Principal.WindowsIdentity]::GetCurrent()
$principal = New-Object Security.Principal.WindowsPrincipal($currentUser)

if (-not $principal.IsInRole(
    [Security.Principal.WindowsBuiltInRole]::Administrator
)) {
    Write-Host "Error: Please run PowerShell as Administrator." -ForegroundColor Red
    exit 1
}

# DNS servers
$PreferredDNS = "8.8.8.8"
$AlternateDNS = "8.8.4.4"

Write-Host "Getting active network adapters..." -ForegroundColor Cyan

# Get all active network adapters
$Adapters = Get-NetAdapter | Where-Object {
    $_.Status -eq "Up"
}

if (-not $Adapters) {
    Write-Host "No active network adapters found." -ForegroundColor Yellow
    exit 1
}

# Set DNS on each active adapter
foreach ($Adapter in $Adapters) {

    Write-Host "Setting DNS for: $($Adapter.Name)" -ForegroundColor Cyan

    try {
        Set-DnsClientServerAddress `
            -InterfaceIndex $Adapter.InterfaceIndex `
            -ServerAddresses @($PreferredDNS, $AlternateDNS) `
            -ErrorAction Stop

        Write-Host "  DNS set successfully." -ForegroundColor Green
    }
    catch {
        Write-Host "  Failed: $($_.Exception.Message)" -ForegroundColor Red
    }
}

# Verify DNS configuration
Write-Host "`nDNS configuration:" -ForegroundColor Cyan

Get-DnsClientServerAddress |
    Where-Object {
        $_.AddressFamily -eq 2
    } |
    Select-Object InterfaceAlias, InterfaceIndex, ServerAddresses |
    Format-Table -AutoSize

Write-Host "`nDNS configuration complete." -ForegroundColor Green